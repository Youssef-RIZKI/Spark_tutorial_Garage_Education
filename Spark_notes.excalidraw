      "type": "text",
      "x": 511.6322918961245,
      "y": 11070.341378045337,
      "width": 1001.559326171875,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#e9ecef",
