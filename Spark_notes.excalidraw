    {
      "id": "XKxhWO2hTquJHmN0MPE-m",
      "type": "text",
      "x": 451.9821312199731,
      "y": 949.3753556668428,
      "width": 1035.359130859375,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8y",
      "roundness": null,
      "seed": 668380049,
      "version": 444,
      "versionNonce": 125596186,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784976351635,
      "link": null,
      "locked": false,
      "text": "- Spark simplified big data processing through an abstraction called RDD \"Resilient Distributed Dataset\" \n- RDDs become the foundation for hight-level data structure (Data frames, DataSets)\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Spark simplified big data processing through an abstraction called RDD \"Resilient Distributed Dataset\" \n- RDDs become the foundation for hight-level data structure (Data frames, DataSets)\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
