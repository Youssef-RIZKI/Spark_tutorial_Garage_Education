      "boundElements": [],
      "updated": 1785832832758,
      "link": null,
      "locked": false,
      "text": "Aggregation : ReduceByKey vs GroupByKey ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
