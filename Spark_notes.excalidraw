      "text": "from pyspark.sql import SparkSession\n\nspark = SparkSession\\\n            .builder\\\n            .master(\"masterUrl\")   \n            .appName(\"AppName\")\\\n            .config(\"configOption\", \"configValue\")\n            .getOrCreate()",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "from pyspark.sql import SparkSession\n\nspark = SparkSession\\\n            .builder\\\n            .master(\"masterUrl\")   \n            .appName(\"AppName\")\\\n            .config(\"configOption\", \"configValue\")\n            .getOrCreate()",
      "autoResize": true,
      "lineHeight": 1.25
