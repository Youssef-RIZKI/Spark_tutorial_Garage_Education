    },
    {
      "id": "b6FYcR5vrwv3t58p_oMLL",
      "type": "text",
      "x": 511.0843202842449,
      "y": 12821.270402480019,
      "width": 911.359375,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#e9ecef",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bBY",
      "roundness": null,
      "seed": 1233750275,
      "version": 333,
      "versionNonce": 844422413,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785763302462,
      "link": null,
      "locked": false,
      "text": "- Wide transformation requires shuffling unlike narrow transformations.\n- Data processing is limited to one single data partition.\n- Narrow transformations is optimal for data movement and for independent data processing \n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Wide transformation requires shuffling unlike narrow transformations.\n- Data processing is limited to one single data partition.\n- Narrow transformations is optimal for data movement and for independent data processing \n",
      "autoResize": true,
      "lineHeight": 1.25
    },
